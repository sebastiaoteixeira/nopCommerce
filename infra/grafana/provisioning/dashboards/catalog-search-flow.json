          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(nopcommerce_catalog_pricing_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A",
          "interval": "5s"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nopcommerce_catalog_pricing_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "B",
          "interval": "5s"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(nopcommerce_catalog_pricing_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "C",
          "interval": "5s"
        }
      ]
    },
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 7,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count[1m]))",
