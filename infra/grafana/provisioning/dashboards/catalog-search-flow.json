{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "5s",
  "panels": [
    {
      "type": "row",
      "title": "BI Indicators",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Average Results per Search",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          },
          "min": 0,
          "max": 20
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "sum(rate(nopcommerce_catalog_search_result_count_results_sum[1m])) / sum(rate(nopcommerce_catalog_search_result_count_results_count[1m]))",
          "legendFormat": "avg results",
          "refId": "A",
          "interval": "5s"
        }
      ]
    },
    {
      "title": "Empty Results Ratio",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "orange", "value": 25 },
              { "color": "red", "value": 50 }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "(sum(rate(nopcommerce_catalog_search_empty_results_total[1m])) / sum(rate(nopcommerce_catalog_search_duration_milliseconds_count[1m]))) * 100",
          "legendFormat": "empty %",
          "refId": "A",
          "interval": "5s"
        }
      ]
    },
    {
      "title": "Search Requests by Keyword Presence",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "lineWidth": 2,
            "gradientMode": "opacity",
            "spanNulls": true,
            "pointSize": 5,
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "with keywords" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "without keywords" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(rate(nopcommerce_catalog_search_duration_milliseconds_count{search_has_keywords=\"true\"}[1m]))",
          "legendFormat": "with keywords",
          "refId": "A",
          "interval": "5s"
        },
        {
          "expr": "sum(rate(nopcommerce_catalog_search_duration_milliseconds_count{search_has_keywords=\"false\"}[1m]))",
          "legendFormat": "without keywords",
          "refId": "B",
          "interval": "5s"
        }
      ]
    },
    {
      "title": "Empty Results Ratio Over Time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "id": 30,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "gradientMode": "scheme",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "area" }
          },
          "color": { "mode": "continuous-GrYlRd" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(sum(rate(nopcommerce_catalog_search_empty_results_total[1m])) / sum(rate(nopcommerce_catalog_search_duration_milliseconds_count[1m]))) * 100",
          "legendFormat": "empty %",
          "refId": "A",
          "interval": "5s"
        }
      ]
    },
    {
      "title": "Top Searches",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "id": 40,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "color": { "mode": "continuous-BlPu" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10
      },
      "targets": [
        {
          "expr": "topk(10, round(sum by (search_keyword) (increase(nopcommerce_catalog_search_by_keyword_total[5m]))))",
          "legendFormat": "{{search_keyword}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
