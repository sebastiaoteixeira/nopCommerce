{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "refresh": "5s",
  "panels": [
    {
      "title": "Trace Explorer",
      "type": "traces",
      "datasource": {
        "type": "jaeger",
        "uid": "jaeger"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "refId": "A",
          "queryType": "search",
          "service": "nopcommerce",
          "limit": 20,
          "interval": "5s"
        }
      ]
    },
    {
      "title": "Search Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(nopcommerce_catalog_search_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A",
          "interval": "5s"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nopcommerce_catalog_search_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "B",
          "interval": "5s"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(nopcommerce_catalog_search_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "C",
          "interval": "5s"
        }
      ]
    },
    {
      "title": "Empty Results Ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(sum(rate(nopcommerce_catalog_search_empty_results_total[1m])) / sum(rate(nopcommerce_catalog_search_duration_milliseconds_count[1m]))) * 100",
          "legendFormat": "empty %",
          "refId": "A",
          "interval": "5s"
        }
      ]
    },
    {
      "title": "HTTP Error Rate (5xx)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[1m]))",
          "legendFormat": "5xx errors/s",
          "refId": "A",
          "interval": "5s"
        }
      ]
    },
    {
      "title": "Search Requests by Keyword Presence",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(nopcommerce_catalog_search_duration_milliseconds_count{search_has_keywords=\"true\"}[10s]))",
          "legendFormat": "with keywords",
          "refId": "A",
          "interval": "5s"
        },
        {
          "expr": "sum(rate(nopcommerce_catalog_search_duration_milliseconds_count{search_has_keywords=\"false\"}[10s]))",
          "legendFormat": "without keywords",
          "refId": "B",
          "interval": "5s"
        }
      ]
    },
    {
      "title": "Average Results per Search",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(nopcommerce_catalog_search_result_count_results_sum[1m])) / sum(rate(nopcommerce_catalog_search_result_count_results_count[1m]))",
          "legendFormat": "avg results",
          "refId": "A",
          "interval": "5s"
        }
      ]
    },
    {
      "title": "Pricing Duration (p50 / p95 / p99)",
